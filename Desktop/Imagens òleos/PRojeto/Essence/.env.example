# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel:
# Project Settings > Environment Variables. Nunca faça commit dos valores reais.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: ID do usuário admin (padrão: o ID que já estava no código)
ADMIN_USER_ID=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_QUARTERLY=
STRIPE_PRICE_ID_ANNUAL=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=

# --- IA (chamada pelo servidor; NÃO use mais NEXT_PUBLIC_ESSENCE_API_SECRET) ---
ESSENCE_API_SECRET=
# Opcional: endereço da essence-api (padrão: https://essence-api-xrz6.vercel.app/api/ai-sugestoes)
ESSENCE_API_URL=

# --- URLs do site ---
NEXT_PUBLIC_SITE_URL=https://www.essenceapp.com.br
NEXT_PUBLIC_APP_URL=https://www.essenceapp.com.br
NEXT_PUBLIC_URL=https://www.essenceapp.com.br

# --- Meta (Pixel + Conversions API) ---
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=

# --- Google Analytics ---
NEXT_PUBLIC_GA_ID=

# --- Twilio (alarmes por WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Cron da Vercel (check-alarms) ---
CRON_SECRET=
